pipeline {

    agent any

    environment {
        DOCKER_IMAGE = 'rekhadeepa/bms:latest'
        CONTAINER_NAME = 'bms'
        APP_DIR = 'bookmyshow-app'
    }

    stages {

        stage('Clean Workspace') {
            steps {
                cleanWs()
            }
        }

        stage('Checkout') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/Rekha-ops-devops/Book-My-Show.git'

                sh '''
                    echo "========== CHECKOUT =========="
                    pwd
                    ls -la
                    echo "Application files:"
                    ls -la bookmyshow-app

                    test -f bookmyshow-app/package.json
                    test -f bookmyshow-app/Dockerfile

                    echo "Checkout successful."
                '''
            }
        }

        stage('Install Dependencies') {
            steps {
                dir("${APP_DIR}") {
                    sh '''
                        echo "========== INSTALL DEPENDENCIES =========="

                        node --version
                        npm --version

                        rm -rf node_modules

                        echo "Installing npm dependencies..."
                        npm install --legacy-peer-deps

                        echo "Dependencies installed successfully."
                    '''
                }
            }
        }

        stage('Build Application') {
            steps {
                dir("${APP_DIR}") {
                    sh '''
                        echo "========== BUILD APPLICATION =========="

                        export NODE_OPTIONS=--openssl-legacy-provider

                        npm run build

                        echo "Application build successful."
                        ls -la build
                    '''
                }
            }
        }

        stage('OWASP Dependency Check') {
            steps {

                withCredentials([
                    string(
                        credentialsId: 'nvd-api-key',
                        variable: 'NVD_API_KEY'
                    )
                ]) {

                    catchError(
                        buildResult: 'UNSTABLE',
                        stageResult: 'UNSTABLE'
                    ) {

                        dependencyCheck(
                            odcInstallation: 'DP-Check',
                            additionalArguments: "--scan . --disableYarnAudit --disableNodeAudit --nvdApiKey ${NVD_API_KEY}"
                        )
                    }
                }
            }

            post {
                always {
                    dependencyCheckPublisher(
                        pattern: '**/dependency-check-report.xml',
                        stopBuild: false
                    )
                }
            }
        }

        stage('Trivy FS Scan') {
            steps {
                sh '''
                    echo "========== TRIVY FILESYSTEM SCAN =========="

                    trivy fs . \
                        --scanners vuln,secret \
                        --format table \
                        -o trivyfs.txt .

                    echo "========== TRIVY REPORT =========="
                    cat trivyfs.txt
                '''
            }

            post {
                always {
                    archiveArtifacts(
                        artifacts: 'trivyfs.txt',
                        allowEmptyArchive: true
                    )
                }
            }
        }

        stage('Docker Build') {
            steps {
                sh '''
                    echo "========== DOCKER BUILD =========="

                    docker build \
                        --no-cache \
                        -t ${DOCKER_IMAGE} \
                        -f ${APP_DIR}/Dockerfile \
                        ${APP_DIR}

                    echo "Docker image built successfully."

                    docker images | grep bms || true
                '''
            }
        }

        stage('Docker Push') {
            steps {

                withDockerRegistry(
                    credentialsId: 'docker',
                    toolName: 'docker'
                ) {

                    sh '''
                        echo "========== DOCKER PUSH =========="

                        docker push ${DOCKER_IMAGE}

                        echo "Docker image pushed successfully."
                    '''
                }
            }
        }

        stage('Deploy Container') {
            steps {
                sh '''
                    echo "========== DEPLOY CONTAINER =========="

                    echo "Stopping old container..."
                    docker stop ${CONTAINER_NAME} || true

                    echo "Removing old container..."
                    docker rm ${CONTAINER_NAME} || true

                    echo "Pulling latest image..."
                    docker pull ${DOCKER_IMAGE}

                    echo "Starting new container..."

                    docker run -d \
                        --restart=always \
                        --name ${CONTAINER_NAME} \
                        -p 3000:3000 \
                        ${DOCKER_IMAGE}

                    echo "Waiting for application..."
                    sleep 15

                    echo "========== CONTAINER STATUS =========="

                    docker ps -a

                    if [ "$(docker inspect -f '{{.State.Running}}' ${CONTAINER_NAME})" != "true" ]; then
                        echo "ERROR: Container failed to start."
                        docker logs ${CONTAINER_NAME}
                        exit 1
                    fi

                    echo "Container is running successfully."

                    echo "========== APPLICATION LOGS =========="

                    docker logs --tail 50 ${CONTAINER_NAME}
                '''
            }
        }
    }

    post {

        success {
            emailext(
                to: 'rekhask977@gmail.com',
                subject: "SUCCESS: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                body: """
                    <h3>Book My Show Pipeline Successful</h3>

                    <p><b>Project:</b> ${env.JOB_NAME}</p>
                    <p><b>Build:</b> #${env.BUILD_NUMBER}</p>
                    <p><b>Status:</b> SUCCESS</p>
                    <p><b>Docker Image:</b> ${DOCKER_IMAGE}</p>
                    <p><b>Application Port:</b> 3000</p>
                    <p><b>Build URL:</b> ${env.BUILD_URL}</p>
                """,
                attachLog: true,
                attachmentsPattern: 'trivyfs.txt'
            )
        }

        unstable {
            emailext(
                to: 'rekhask977@gmail.com',
                subject: "UNSTABLE: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                body: """
                    <h3>Book My Show Pipeline Unstable</h3>

                    <p><b>Project:</b> ${env.JOB_NAME}</p>
                    <p><b>Build:</b> #${env.BUILD_NUMBER}</p>
                    <p><b>Status:</b> UNSTABLE</p>
                    <p><b>Build URL:</b> ${env.BUILD_URL}</p>

                    <p>Check OWASP/Trivy scan results.</p>
                """,
                attachLog: true,
                attachmentsPattern: 'trivyfs.txt'
            )
        }

        failure {
            emailext(
                to: 'rekhask977@gmail.com',
                subject: "FAILED: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                body: """
                    <h3>Book My Show Pipeline Failed</h3>

                    <p><b>Project:</b> ${env.JOB_NAME}</p>
                    <p><b>Build:</b> #${env.BUILD_NUMBER}</p>
                    <p><b>Status:</b> FAILURE</p>
                    <p><b>Build URL:</b> ${env.BUILD_URL}</p>

                    <p>Check the Jenkins console output for the failure.</p>
                """,
                attachLog: true,
                attachmentsPattern: 'trivyfs.txt'
            )
        }

        always {
            echo "======================================"
            echo "       PIPELINE FINISHED"
            echo "======================================"
            echo "Build Number : ${env.BUILD_NUMBER}"
            echo "Result       : ${currentBuild.currentResult}"
            echo "======================================"
        }
    }
}
