pipeline {

    agent any

    environment {
        DOCKER_IMAGE = 'rekhadeepa/bms:latest'
        CONTAINER_NAME = 'bms'
        APP_DIR = 'bookmyshow-app'
    }

    stages {

        stage('Clean Workspace') {
            steps {
                cleanWs()
            }
        }

        stage('Checkout') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/Rekha-ops-devops/Book-My-Show.git'

                sh '''
                    echo "======================================"
                    echo "CHECKOUT"
                    echo "======================================"

                    pwd
                    ls -la

                    echo "Application:"
                    ls -la bookmyshow-app

                    test -f bookmyshow-app/package.json
                    test -f bookmyshow-app/Dockerfile

                    echo "Checkout successful."
                '''
            }
        }

        stage('Install Dependencies') {
            steps {
                dir("${APP_DIR}") {
                    sh '''
                        echo "======================================"
                        echo "INSTALL DEPENDENCIES"
                        echo "======================================"

                        node --version
                        npm --version

                        rm -rf node_modules

                        echo "Running npm install..."
                        npm install --legacy-peer-deps

                        echo "Dependencies installed successfully."
                    '''
                }
            }
        }

        stage('Build Application') {
            steps {
                dir("${APP_DIR}") {
                    sh '''
                        echo "======================================"
                        echo "BUILD APPLICATION"
                        echo "======================================"

                        export NODE_OPTIONS=--openssl-legacy-provider

                        npm run build

                        echo "Build successful."

                        ls -la build
                    '''
                }
            }
        }

        stage('OWASP Dependency Check') {
            steps {

                withCredentials([
                    string(
                        credentialsId: 'nvd-api-key',
                        variable: 'NVD_API_KEY'
                    )
                ]) {

                    sh '''
                        echo "======================================"
                        echo "OWASP DEPENDENCY CHECK"
                        echo "======================================"

                        if command -v dependency-check.sh >/dev/null 2>&1
                        then
                            echo "Dependency Check found."

                            dependency-check.sh \
                                --project "Book-My-Show" \
                                --scan . \
                                --format XML \
                                --out dependency-check-report \
                                --nvdApiKey "$NVD_API_KEY" \
                                --disableYarnAudit \
                                --disableNodeAudit

                        else
                            echo "WARNING: dependency-check.sh is not installed."
                            echo "Skipping OWASP scan."
                        fi

                        echo "OWASP stage completed."
                    '''
                }
            }
        }

        stage('Trivy FS Scan') {
            steps {
                sh '''
                    echo "======================================"
                    echo "TRIVY FILESYSTEM SCAN"
                    echo "======================================"

                    if command -v trivy >/dev/null 2>&1
                    then

                        trivy fs . \
                            --scanners vuln,secret \
                            --format table \
                            -o trivyfs.txt \
                            .

                        echo "Trivy scan completed."

                        cat trivyfs.txt

                    else

                        echo "WARNING: Trivy is not installed."
                        echo "Skipping Trivy scan."

                        echo "Trivy not installed." > trivyfs.txt

                    fi
                '''
            }

            post {
                always {
                    archiveArtifacts(
                        artifacts: 'trivyfs.txt',
                        allowEmptyArchive: true
                    )
                }
            }
        }

        stage('Docker Build') {
            steps {
                sh '''
                    echo "======================================"
                    echo "DOCKER BUILD"
                    echo "======================================"

                    docker --version

                    docker build \
                        --no-cache \
                        -t ${DOCKER_IMAGE} \
                        -f ${APP_DIR}/Dockerfile \
                        ${APP_DIR}

                    echo "Docker image built successfully."

                    docker images | grep rekhadeepa || true
                '''
            }
        }

        stage('Docker Login & Push') {
            steps {

                withCredentials([
                    usernamePassword(
                        credentialsId: 'docker',
                        usernameVariable: 'DOCKER_USERNAME',
                        passwordVariable: 'DOCKER_PASSWORD'
                    )
                ]) {

                    sh '''
                        echo "======================================"
                        echo "DOCKER LOGIN"
                        echo "======================================"

                        set +x

                        echo "$DOCKER_PASSWORD" | docker login \
                            --username "$DOCKER_USERNAME" \
                            --password-stdin

                        echo "Docker login successful."

                        echo "======================================"
                        echo "DOCKER PUSH"
                        echo "======================================"

                        docker push ${DOCKER_IMAGE}

                        echo "Docker image pushed successfully."

                        docker logout
                    '''
                }
            }
        }

        stage('Deploy Container') {
            steps {
                sh '''
                    echo "======================================"
                    echo "DEPLOY CONTAINER"
                    echo "======================================"

                    echo "Stopping existing container..."

                    docker stop ${CONTAINER_NAME} || true

                    echo "Removing existing container..."

                    docker rm ${CONTAINER_NAME} || true

                    echo "Pulling latest Docker image..."

                    docker pull ${DOCKER_IMAGE}

                    echo "Starting new container..."

                    docker run -d \
                        --restart=always \
                        --name ${CONTAINER_NAME} \
                        -p 3000:3000 \
                        ${DOCKER_IMAGE}

                    echo "Waiting for application..."

                    sleep 15

                    echo "======================================"
                    echo "CONTAINER STATUS"
                    echo "======================================"

                    docker ps -a

                    echo "======================================"
                    echo "CHECKING CONTAINER"
                    echo "======================================"

                    if [ "$(docker inspect -f '{{.State.Running}}' ${CONTAINER_NAME})" != "true" ]
                    then

                        echo "ERROR: Container is not running."

                        docker logs ${CONTAINER_NAME}

                        exit 1

                    fi

                    echo "Container is running successfully."

                    echo "======================================"
                    echo "APPLICATION LOGS"
                    echo "======================================"

                    docker logs --tail 50 ${CONTAINER_NAME}
                '''
            }
        }
    }

    post {

        success {

            echo "======================================"
            echo "PIPELINE SUCCESS"
            echo "======================================"

            emailext(
                to: 'rekhask977@gmail.com',
                subject: "SUCCESS: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                body: """
Book My Show Pipeline Successful

Build Number : ${env.BUILD_NUMBER}
Docker Image : ${DOCKER_IMAGE}
Container    : ${CONTAINER_NAME}
Port         : 3000

Build URL:
${env.BUILD_URL}
                """,
                attachLog: true,
                attachmentsPattern: 'trivyfs.txt'
            )
        }

        failure {

            echo "======================================"
            echo "PIPELINE FAILED"
            echo "======================================"

            emailext(
                to: 'rekhask977@gmail.com',
                subject: "FAILED: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                body: """
Book My Show Pipeline Failed

Build Number : ${env.BUILD_NUMBER}

Build URL:
${env.BUILD_URL}

Please check Jenkins Console Output.
                """,
                attachLog: true,
                attachmentsPattern: 'trivyfs.txt'
            )
        }

        always {

            echo "======================================"
            echo "PIPELINE FINISHED"
            echo "======================================"

            echo "Build Number : ${env.BUILD_NUMBER}"
            echo "Result       : ${currentBuild.currentResult}"

            echo "======================================"
        }
    }
}
