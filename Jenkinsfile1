pipeline {
    agent any

    tools {
        nodejs 'node23'
    }

    environment {
        DOCKER_IMAGE = 'rekhadeepa/bms:latest'
        CONTAINER_NAME = 'bms'
        APP_DIR = 'bookmyshow-app'
    }

    stages {

        stage('Clean Workspace') {
            steps {
                cleanWs()
            }
        }

        stage('Checkout from Git') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/Rekha-ops-devops/Book-My-Show.git'

                sh '''
                    echo "========== Workspace =========="
                    pwd
                    ls -la

                    echo "========== Application =========="
                    ls -la bookmyshow-app

                    echo "Checking package files..."
                    test -f bookmyshow-app/package.json
                    test -f bookmyshow-app/package-lock.json

                    echo "Checkout successful."
                '''
            }
        }

        stage('Install Dependencies') {
            steps {
                dir("${APP_DIR}") {
                    sh '''
                        echo "========== Installing Dependencies =========="

                        node --version
                        npm --version

                        if [ ! -f package.json ]; then
                            echo "ERROR: package.json not found!"
                            exit 1
                        fi

                        if [ ! -f package-lock.json ]; then
                            echo "ERROR: package-lock.json not found!"
                            exit 1
                        fi

                        echo "Removing old node_modules..."
                        rm -rf node_modules

                        echo "Installing dependencies..."
                        npm ci --legacy-peer-deps

                        echo "Dependencies installed successfully."
                    '''
                }
            }
        }

        stage('OWASP FS Scan') {
            steps {
                withCredentials([
                    string(
                        credentialsId: 'nvd-api-key',
                        variable: 'NVD_API_KEY'
                    )
                ]) {
                    catchError(
                        buildResult: 'UNSTABLE',
                        stageResult: 'UNSTABLE'
                    ) {
                        dependencyCheck(
                            odcInstallation: 'DP-Check',
                            additionalArguments: "--scan ./ --disableYarnAudit --disableNodeAudit --nvdApiKey ${NVD_API_KEY}"
                        )
                    }
                }
            }

            post {
                always {
                    dependencyCheckPublisher(
                        pattern: '**/dependency-check-report.xml',
                        stopBuild: false
                    )
                }
            }
        }

        stage('Trivy FS Scan') {
            steps {
                sh '''
                    echo "========== Trivy Filesystem Scan =========="

                    trivy fs . \
                        --scanners vuln,secret \
                        --format table \
                        -o trivyfs.txt \
                        .

                    echo "Trivy filesystem scan completed."

                    echo "========== Trivy Report =========="
                    cat trivyfs.txt
                '''
            }
        }

        stage('Docker Build & Push') {
            steps {
                script {
                    withDockerRegistry(
                        credentialsId: 'docker',
                        toolName: 'docker'
                    ) {
                        sh '''
                            echo "========== Docker Build =========="

                            docker build \
                                --no-cache \
                                -t ${DOCKER_IMAGE} \
                                -f ${APP_DIR}/Dockerfile \
                                ${APP_DIR}

                            echo "Docker image built successfully."

                            echo "========== Docker Push =========="

                            docker push ${DOCKER_IMAGE}

                            echo "Docker image pushed successfully."
                        '''
                    }
                }
            }
        }

        stage('Deploy to Container') {
            steps {
                sh '''
                    echo "========== Deploying Application =========="

                    echo "Stopping old container..."
                    docker stop ${CONTAINER_NAME} || true

                    echo "Removing old container..."
                    docker rm ${CONTAINER_NAME} || true

                    echo "Pulling latest Docker image..."
                    docker pull ${DOCKER_IMAGE}

                    echo "Starting new container..."
                    docker run -d \
                        --restart=always \
                        --name ${CONTAINER_NAME} \
                        -p 3000:3000 \
                        ${DOCKER_IMAGE}

                    echo "Waiting for application to start..."
                    sleep 15

                    echo "========== Container Status =========="
                    docker ps -a

                    echo "========== Checking Container =========="

                    if [ "$(docker inspect -f '{{.State.Running}}' ${CONTAINER_NAME})" != "true" ]; then
                        echo "ERROR: Container is not running!"
                        docker logs ${CONTAINER_NAME}
                        exit 1
                    fi

                    echo "Container is running successfully."

                    echo "========== Application Logs =========="
                    docker logs --tail 50 ${CONTAINER_NAME}

                    echo "Application deployed successfully."
                '''
            }
        }
    }

    post {

        success {
            emailext(
                to: 'rekhask977@gmail.com',
                subject: "SUCCESS: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                body: """
                    <h3>Build Successful</h3>

                    <p><b>Project:</b> ${env.JOB_NAME}</p>
                    <p><b>Build Number:</b> ${env.BUILD_NUMBER}</p>
                    <p><b>Status:</b> SUCCESS</p>
                    <p><b>Docker Image:</b> ${DOCKER_IMAGE}</p>
                    <p><b>Application:</b> http://localhost:3000</p>
                    <p><b>Build URL:</b> ${env.BUILD_URL}</p>
                """,
                attachLog: true,
                attachmentsPattern: 'trivyfs.txt'
            )
        }

        unstable {
            emailext(
                to: 'rekhask977@gmail.com',
                subject: "UNSTABLE: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                body: """
                    <h3>Build Unstable</h3>

                    <p><b>Project:</b> ${env.JOB_NAME}</p>
                    <p><b>Build Number:</b> ${env.BUILD_NUMBER}</p>
                    <p><b>Status:</b> UNSTABLE</p>
                    <p><b>Build URL:</b> ${env.BUILD_URL}</p>

                    <p>Check the Jenkins console for security scan details.</p>
                """,
                attachLog: true,
                attachmentsPattern: 'trivyfs.txt'
            )
        }

        failure {
            emailext(
                to: 'rekhask977@gmail.com',
                subject: "FAILED: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                body: """
                    <h3>Build Failed</h3>

                    <p><b>Project:</b> ${env.JOB_NAME}</p>
                    <p><b>Build Number:</b> ${env.BUILD_NUMBER}</p>
                    <p><b>Status:</b> FAILURE</p>
                    <p><b>Build URL:</b> ${env.BUILD_URL}</p>

                    <p>Check the attached Jenkins log for the failure reason.</p>
                """,
                attachLog: true,
                attachmentsPattern: 'trivyfs.txt'
            )
        }

        always {
            echo "========== Pipeline Finished =========="
            echo "Build: ${env.BUILD_NUMBER}"
            echo "Result: ${currentBuild.currentResult}"
        }
    }
}
