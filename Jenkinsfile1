pipeline {
    agent any

    tools {
        jdk 'JDK17'
        nodejs 'node23'
    }

    stages {

        stage('Clean Workspace') {
            steps {
                cleanWs()
            }
        }

        stage('Checkout from Git') {
            steps {
                git(
                    branch: 'main',
                    url: 'https://github.com/Rekha-ops-devops/Book-My-Show.git'
                )

                sh 'ls -la'
            }
        }

        stage('Install Dependencies') {
            steps {
                sh '''
                    cd bookmyshow-app

                    echo "Checking application files..."
                    ls -la

                    if [ -f package.json ]; then
                        echo "Installing dependencies..."

                        rm -rf node_modules package-lock.json

                        npm install
                    else
                        echo "ERROR: package.json not found in bookmyshow-app!"
                        exit 1
                    fi
                '''
            }
        }

      stage('OWASP FS Scan') {
    steps {
        sh '''
            echo "Running OWASP Dependency Check..."

            dependency-check.sh \
                --project "BookMyShow" \
                --scan . \
                --format XML \
                --out dependency-check-report \
                --failOnCVSS 11 || true

            echo "OWASP Dependency Check completed."
        '''
    }
}


        stage('Trivy FS Scan') {
            steps {
                sh '''
                    echo "Running Trivy filesystem scan..."

                    trivy fs . > trivyfs.txt

                    echo "Trivy scan completed."
                '''
            }
        }

        stage('Docker Build & Push') {
            steps {
                script {
                    withDockerRegistry(
                        credentialsId: 'docker',
                        toolName: 'docker'
                    ) {
                        sh '''
                            echo "Building Docker image..."

                            docker build \
                                --no-cache \
                                -t rekhadeepa/bms:latest \
                                -f bookmyshow-app/Dockerfile \
                                bookmyshow-app

                            echo "Pushing Docker image to registry..."

                            docker push rekhadeepa/bms:latest

                            echo "Docker image pushed successfully."
                        '''
                    }
                }
            }
        }

        stage('Deploy to Container') {
            steps {
                sh '''
                    echo "Stopping and removing old container..."

                    docker stop bms || true
                    docker rm bms || true

                    echo "Pulling latest image..."

                    docker pull rekhadeepa/bms:latest

                    echo "Running new container..."

                    docker run -d \
                        --restart=always \
                        --name bms \
                        -p 3000:3000 \
                        rekhadeepa/bms:latest

                    echo "Waiting for application..."

                    sleep 10

                    echo "Checking container..."

                    docker ps -a

                    echo "Checking container status..."

                    if [ "$(docker inspect -f '{{.State.Running}}' bms)" != "true" ]; then
                        echo "ERROR: Container is not running"

                        docker logs bms

                        exit 1
                    fi

                    echo "Container is running successfully!"

                    echo "Application logs:"

                    docker logs --tail 50 bms
                '''
            }
        }
    }

    post {
        always {
            emailext(
                attachLog: true,
                subject: "${currentBuild.result}",
                body: """
                    Project: ${env.JOB_NAME}<br/>
                    Build Number: ${env.BUILD_NUMBER}<br/>
                    Build Status: ${currentBuild.result}<br/>
                    URL: ${env.BUILD_URL}<br/>
                """,
                to: 'rekhask977@gmail.com',
                attachmentsPattern: 'trivyfs.txt,trivyimage.txt'
            )
        }
    }
}
