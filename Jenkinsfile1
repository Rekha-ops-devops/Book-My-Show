pipeline {

    agent any

    environment {
        APP_DIR = 'bookmyshow-app'
        IMAGE_NAME = 'bookmyshow'
        DOCKER_CREDENTIAL_ID = 'dockerhub-credentials'
        NVD_CREDENTIAL_ID = 'nvd-api-key'
    }

    stages {

        stage('Checkout') {
            steps {
                echo '======================================'
                echo 'CHECKOUT SOURCE CODE'
                echo '======================================'

                checkout scm

                sh '''
                    echo "Workspace:"
                    pwd

                    echo "Repository files:"
                    ls -la

                    echo "Application files:"
                    ls -la bookmyshow-app

                    test -f bookmyshow-app/package.json
                    test -f bookmyshow-app/Dockerfile

                    echo "Checkout successful."
                '''
            }
        }


        stage('Install Dependencies') {
            steps {

                nodejs(nodeJSInstallationName: 'NodeJS') {

                    dir("${APP_DIR}") {

                        sh '''
                            echo '======================================'
                            echo 'NODE / NPM VERSION'
                            echo '======================================'

                            node --version
                            npm --version

                            echo '======================================'
                            echo 'INSTALLING DEPENDENCIES'
                            echo '======================================'

                            rm -rf node_modules

                            npm install --legacy-peer-deps

                            echo "Dependencies installed successfully."
                        '''
                    }
                }
            }
        }


        stage('Build Application') {
            steps {

                nodejs(nodeJSInstallationName: 'NodeJS') {

                    dir("${APP_DIR}") {

                        sh '''
                            echo '======================================'
                            echo 'BUILD APPLICATION'
                            echo '======================================'

                            npm run build

                            echo "Application build successful."
                        '''
                    }
                }
            }
        }


        stage('OWASP Dependency Check') {
            steps {

                withCredentials([
                    string(
                        credentialsId: "${NVD_CREDENTIAL_ID}",
                        variable: 'NVD_API_KEY'
                    )
                ]) {

                    sh '''
                        echo '======================================'
                        echo 'OWASP DEPENDENCY CHECK'
                        echo '======================================'

                        if command -v dependency-check.sh >/dev/null 2>&1
                        then

                            mkdir -p dependency-check-report

                            dependency-check.sh \
                                --project "Book-My-Show" \
                                --scan "${WORKSPACE}/${APP_DIR}" \
                                --format HTML \
                                --out "${WORKSPACE}/dependency-check-report" \
                                --nvdApiKey "${NVD_API_KEY}"

                        else

                            echo "OWASP Dependency-Check is not installed."
                            echo "Skipping OWASP scan."

                        fi
                    '''
                }
            }
        }


        stage('Trivy FS Scan') {
            steps {

                sh '''
                    echo '======================================'
                    echo 'TRIVY FILESYSTEM SCAN'
                    echo '======================================'

                    if command -v trivy >/dev/null 2>&1
                    then

                        trivy fs \
                            --scanners vuln \
                            --severity HIGH,CRITICAL \
                            --exit-code 0 \
                            "${APP_DIR}"

                    else

                        echo "Trivy is not installed."
                        echo "Skipping Trivy scan."

                    fi
                '''
            }
        }


        stage('Docker Build') {
            steps {

                sh '''
                    echo '======================================'
                    echo 'DOCKER BUILD'
                    echo '======================================'

                    docker --version

                    docker build \
                        -t "${IMAGE_NAME}:${BUILD_NUMBER}" \
                        -t "${IMAGE_NAME}:latest" \
                        "${APP_DIR}"

                    echo "Docker build successful."

                    docker images | grep "${IMAGE_NAME}" || true
                '''
            }
        }


        stage('Docker Login & Push') {
            steps {

                withCredentials([
                    usernamePassword(
                        credentialsId: "${DOCKER_CREDENTIAL_ID}",
                        usernameVariable: 'DOCKER_USERNAME',
                        passwordVariable: 'DOCKER_PASSWORD'
                    )
                ]) {

                    sh '''
                        echo '======================================'
                        echo 'DOCKER LOGIN'
                        echo '======================================'

                        echo "${DOCKER_PASSWORD}" | docker login \
                            --username "${DOCKER_USERNAME}" \
                            --password-stdin

                        echo '======================================'
                        echo 'TAGGING IMAGE'
                        echo '======================================'

                        docker tag \
                            "${IMAGE_NAME}:${BUILD_NUMBER}" \
                            "${DOCKER_USERNAME}/${IMAGE_NAME}:${BUILD_NUMBER}"

                        docker tag \
                            "${IMAGE_NAME}:latest" \
                            "${DOCKER_USERNAME}/${IMAGE_NAME}:latest"

                        echo '======================================'
                        echo 'PUSHING IMAGE'
                        echo '======================================'

                        docker push \
                            "${DOCKER_USERNAME}/${IMAGE_NAME}:${BUILD_NUMBER}"

                        docker push \
                            "${DOCKER_USERNAME}/${IMAGE_NAME}:latest"

                        docker logout

                        echo "Docker push successful."
                    '''
                }
            }
        }


        stage('Deploy Container') {
            steps {

                sh '''
                    echo '======================================'
                    echo 'DEPLOY CONTAINER'
                    echo '======================================'

                    docker rm -f bookmyshow-container 2>/dev/null || true

                    docker run -d \
                        --name bookmyshow-container \
                        -p 3000:3000 \
                        "${IMAGE_NAME}:${BUILD_NUMBER}"

                    echo "Container started."

                    docker ps | grep bookmyshow-container || true
                '''
            }
        }

    }


    post {

        success {
            echo '======================================'
            echo 'PIPELINE SUCCESS'
            echo '======================================'

            echo "Build Number : ${BUILD_NUMBER}"
            echo "Result       : SUCCESS"

            echo '======================================'
        }

        failure {
            echo '======================================'
            echo 'PIPELINE FAILED'
            echo '======================================'

            echo "Build Number : ${BUILD_NUMBER}"
            echo "Result       : FAILURE"

            echo '======================================'
        }

        always {
            echo 'Pipeline completed.'
        }
    }
}
